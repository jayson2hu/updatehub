<view class="page"><view class="hero"><text class="site-title">群内的重要消息</text><text class="description">群公告、使用提醒与维护消息，都在这里留存。</text></view><page-state loading="{{loading}}" error="{{error}}" bindretry="retry"/><block wx:if="{{!loading && !error}}"><view class="filters category-filters"><button wx:for="{{categories}}" wx:key="id" class="filter {{category === item.id ? 'active' : ''}}" bindtap="onCategory" data-id="{{item.id}}" hover-class="pressed">{{item.label}}</button></view><page-state empty="{{!notices.length}}" empty-title="这个分类还没有公告" empty-text="可以切换到全部公告看看。" bindretry="clear"/><view wx:for="{{notices}}" wx:key="id" class="notice-card" bindtap="openNotice" data-slug="{{item.slug}}" aria-role="link" hover-class="pressed"><view class="notice-top"><text class="category">{{item.categoryText}}</text><text class="state-label {{item.ended ? 'ended' : ''}}">{{item.ended ? '已结束' : item.activePinned ? '置顶提醒' : item.importance === 'urgent' ? '重要提醒' : '有效公告'}}</text></view><text class="notice-title">{{item.title}} ›</text><text class="notice-body-summary">{{item.summary}}</text><view class="notice-footer"><text>{{item.date}}</text><text wx:if="{{item.is_demo}}">示例公告</text></view></view><text class="footnote">到期公告自动退出置顶，历史详情仍可打开。</text></block></view>
