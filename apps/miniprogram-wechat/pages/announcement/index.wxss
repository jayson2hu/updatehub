/* 公告详情（UI 规范 §5.6 手机） */
.article{margin-top:32rpx}
.meta{display:block;font-size:24rpx;color:#5F6B80;margin-top:16rpx}
.title{display:block;font-size:44rpx;font-weight:700;line-height:1.4;margin:12rpx 0 16rpx}
.lead{display:block;font-size:30rpx;line-height:1.8;color:#141F33;border-left:6rpx solid #2457E6;padding-left:22rpx;margin:8rpx 0 12rpx}
.body{font-size:32rpx;line-height:1.8;color:#141F33}
.paragraph{display:block;margin:24rpx 0;word-break:break-word}
.content-image{display:block;width:100%;margin:24rpx 0;border-radius:24rpx}
.link-box{background:#fff;border:1px solid #E4E9F2;border-radius:24rpx;padding:24rpx;margin:20rpx 0;display:flex;flex-direction:column;gap:12rpx}
.link-label{font-size:28rpx;font-weight:600}
.link-url{font-size:25rpx;color:#5F6B80;word-break:break-all}
