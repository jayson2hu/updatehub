.announcement-title{display:block;font-size:47rpx;font-weight:600;line-height:1.5;margin:24rpx 0 22rpx}.ended-notice{font-size:27rpx;padding:24rpx;background:#eaf1e7;border:1rpx solid #d6e3d7;border-radius:12rpx;margin-bottom:30rpx;color:#65796b;line-height:1.8}.lead{font-size:33rpx;line-height:1.9;border-left:5rpx solid #35664a;padding-left:25rpx;display:block;margin:10rpx 0 35rpx}.notice-link{margin:25rpx 0;padding:25rpx;background:white;border:1rpx solid #d6e3d7;border-radius:15rpx}.notice-link>text{display:block;font-size:29rpx;margin-bottom:20rpx}.related{padding:30rpx 0}.related-software{display:flex;align-items:center;gap:22rpx;padding:25rpx 0;border-top:1rpx solid #d6e3d7}.related-software>text:nth-child(2){flex:1;font-size:30rpx}.related-software>text:last-child{color:#35664a;font-size:26rpx}.footnote{display:block}
