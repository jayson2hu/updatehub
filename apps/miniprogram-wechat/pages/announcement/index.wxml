<view class="page"><page-state loading="{{loading}}" error="{{error}}" bindretry="retry"/><block wx:if="{{notice && !error && !loading}}"><view class="hero"><text class="demo">{{notice.categoryText}}{{notice.is_demo ? ' · 示例公告' : ''}}</text><text class="announcement-title">{{notice.title}}</text><text class="description">{{notice.date}}<text wx:if="{{notice.ended}}"> · 已结束</text></text></view><view wx:if="{{notice.ended}}" class="ended-notice">本公告已结束，请以当前版本和最新公告为准。</view><text class="lead">{{notice.summary}}</text><view class="body"><text wx:for="{{notice.paragraphs}}" wx:key="*this" class="paragraph" user-select>{{item}}</text></view><image wx:for="{{notice.images}}" wx:key="*this" src="{{item}}" class="content-image" mode="widthFix" lazy-load bindtap="preview" data-src="{{item}}"/><view wx:for="{{notice.links}}" wx:key="url" class="notice-link"><text>{{item.label}}</text><copy-link value="{{item.url}}" label="复制相关链接"/></view><view wx:if="{{software.length}}" class="related"><text class="panel-title">关联软件</text><view wx:for="{{software}}" wx:key="id" class="related-software" data-slug="{{item.slug}}" bindtap="openSoftware" hover-class="pressed"><app-icon name="{{item.name}}" color="{{item.color}}" src="{{item.icon}}"/><text>{{item.name}}</text><text>查看 ›</text></view></view><copy-link value="{{websiteLink}}" label="复制公告网站链接"/><text class="footnote">点击右上角可以分享给群友，网站链接也可直接打开。</text></block></view>
