<view class="sv-page">
  <!-- 头部与统计（R-ME-01） -->
  <view class="me-head">
    <view class="me-av">🙂</view>
    <view class="sv-grow"><text class="me-name">访客</text><text class="me-sub">不用注册 · 收藏保存在这台手机上</text></view>
    <button class="me-sync" bindtap="openSync" data-mode="create" hover-class="sv-pressed">同步码</button>
  </view>
  <view class="me-stats"><view wx:for="{{stats}}" wx:key="label" class="me-stat"><text class="me-stat__v">{{item.value}}</text><text class="me-stat__l">{{item.label}}</text></view></view>
  <page-state loading="{{loading}}" error="{{error}}" bindretry="retry"/>
  <block wx:if="{{!loading && !error}}">
    <!-- 我的收藏（R-ME-02） -->
    <view class="sv-sec sv-card">
      <view class="sv-sh"><view class="sv-sh__title">⭐ 我的收藏<text wx:if="{{updateCount}}" class="sv-badge">{{updateCount}}</text></view><text wx:if="{{updateCount}}" class="sv-sh__more" bindtap="markAllRead" aria-role="button">全部已读</text></view>
      <view wx:if="{{!favorites.length}}" class="sv-empty small-empty"><text class="sv-empty__e">☆</text><text>还没有收藏</text><text class="sv-empty__sub">在软件页点「☆ 收藏」，有新版本时会提醒你</text><button class="sv-btn sv-btn--soft go" bindtap="openLibrary" hover-class="sv-pressed">去软件库看看</button></view>
      <view wx:for="{{favorites}}" wx:key="id" class="sv-lr {{index === 0 ? 'sv-lr--first' : ''}}" bindtap="openSoftware" data-slug="{{item.slug}}" data-platform="{{item.platform}}" hover-class="sv-pressed" aria-role="link" aria-label="{{item.name}}{{item.isNew ? '，有新版本' : ''}}">
        <app-icon size="sm" name="{{item.name}}" color="{{item.color}}" src="{{item.icon}}"/>
        <view class="sv-grow"><view class="sv-lr__name"><text class="sv-ell">{{item.name}}</text><text wx:if="{{item.isNew}}" class="sv-dot"/></view><text class="sv-lr__meta">{{item.version ? item.version + ' · ' + item.date : '暂未发布版本'}}{{item.tag ? ' · ' + item.tag.label : ''}}</text></view>
        <text class="sv-btn sv-btn--sm {{item.isNew ? 'sv-btn--primary' : 'sv-btn--ghost'}} look">{{item.isNew ? '看新版' : '查看'}}</text>
      </view>
    </view>

    <!-- 同步收藏（R-ME-03） -->
    <view class="sv-sec sv-card sync-card">
      <text class="sv-sh__title">🔄 换手机也能保留收藏</text>
      <text class="sv-small sv-muted sync-desc">不用注册。生成一个同步码，在新手机的“我的”页面输入，收藏就回来了。</text>
      <view wx:if="{{syncInfo}}" class="sv-small sync-now">当前同步码 <text class="sv-mono sync-now__c">{{syncInfo.code}}</text> · 还有 {{syncInfo.days}} 天有效</view>
      <view class="sv-actions"><button class="sv-btn sv-btn--primary" bindtap="openSync" data-mode="create" hover-class="sv-pressed">生成同步码</button><button class="sv-btn sv-btn--soft" bindtap="openSync" data-mode="restore" hover-class="sv-pressed">输入同步码</button></view>
    </view>

    <!-- 常用设备（R-ME-04） -->
    <view class="sv-sec sv-card">
      <text class="sv-sh__title">📱 我的常用设备</text>
      <text class="sv-small sv-muted">打开软件页时，默认显示这个设备的下载</text>
      <view class="sv-chips--wrap device-chips"><view wx:for="{{devices}}" wx:key="id" class="sv-chip {{device === item.id ? 'sv-chip--on' : ''}}" bindtap="setDevice" data-id="{{item.id}}" aria-role="radio" aria-checked="{{device === item.id}}"><text class="sv-chip__in">{{item.text}}</text></view></view>
    </view>

    <!-- 更新提醒（R-ME-05） -->
    <view class="sv-sec sv-card">
      <text class="sv-sh__title">🔔 更新提醒</text>
      <view class="sv-setrow sv-setrow--first"><view class="sv-grow"><text>打开小程序时，提醒收藏的软件有新版</text><text class="sv-setrow__sub">在首页和“我的”显示红点</text></view><switch checked="{{remind}}" color="#2BB673" bindchange="onRemind" aria-label="更新提醒"/></view>
      <view class="sv-setrow" bindtap="planned"><view class="sv-grow"><text>微信 / 邮件推送新版本</text><text class="sv-setrow__sub">需要登录 · 规划中</text></view><switch checked="{{false}}" disabled aria-label="推送新版本（规划中）"/></view>
    </view>

    <!-- 最近看过（R-ME-06） -->
    <view wx:if="{{recent.length}}" class="sv-sec">
      <view class="sv-sh"><text class="sv-sh__title">🕘 最近看过</text></view>
      <scroll-view scroll-x class="sv-hs hs-bleed" enhanced show-scrollbar="{{false}}"><view class="sv-hs__row">
        <view wx:for="{{recent}}" wx:key="id" class="sim" bindtap="openSoftware" data-slug="{{item.slug}}" hover-class="sv-pressed" aria-role="link"><app-icon size="sm" name="{{item.name}}" color="{{item.color}}" src="{{item.icon}}"/><text class="sim__n sv-ell">{{item.name}}</text><text class="sv-xs sv-muted sv-mono">{{item.version}}</text></view>
      </view></scroll-view>
    </view>

    <!-- 我的反馈（R-ME-07） -->
    <view class="sv-sec sv-card">
      <text class="sv-sh__title">💬 我的反馈</text>
      <text wx:if="{{!feedbacks.length}}" class="sv-small sv-muted block-text">在软件页点“能正常用 / 有问题”，帮其他群友判断要不要更新。</text>
      <view wx:for="{{feedbacks}}" wx:key="releaseId" class="sv-setrow {{index === 0 ? 'sv-setrow--first' : ''}}" bindtap="openSoftware" data-slug="{{item.slug}}" data-platform="{{item.platform}}"><text class="sv-grow sv-ell">{{item.label}} <text class="sv-xs sv-muted">{{item.platformText}}</text></text><text class="sv-tag sv-tag--{{item.tag.tone}}">{{item.tag.text}}</text></view>
    </view>

    <!-- 想要的软件（R-ME-08） -->
    <view class="sv-sec sv-card">
      <view class="sv-sh"><text class="sv-sh__title">🙋 想要的软件</text><text class="sv-sh__more" bindtap="openWish" aria-role="button">＋ 提交</text></view>
      <text wx:if="{{!wishes.length}}" class="sv-small sv-muted">没找到想要的软件？告诉群主，收录后会在这里显示。</text>
      <view wx:for="{{wishes}}" wx:key="key" data-slug="{{item.software_slug}}" bindtap="openWishSoftware" class="sv-setrow {{index === 0 ? 'sv-setrow--first' : ''}}"><text class="sv-grow sv-ell">{{item.name}}</text><text class="sv-tag sv-tag--{{item.status.tone}}">{{item.status.text}}</text></view>
    </view>

    <!-- 说明（R-ME-09）：小程序不显示「群主后台」入口（R-MINI-10） -->
    <view class="sv-sec sv-card">
      <view class="sv-setrow sv-setrow--first" bindtap="openText" data-kind="about" hover-class="sv-pressed"><text>关于{{siteName}}</text><text class="sv-arr">›</text></view>
      <view class="sv-setrow" bindtap="openText" data-kind="privacy" hover-class="sv-pressed"><text>隐私说明：不收集个人信息，反馈匿名</text><text class="sv-arr">›</text></view>
      <view class="sv-setrow" bindtap="openText" data-kind="disclaimer" hover-class="sv-pressed"><text>免责声明</text><text class="sv-arr">›</text></view>
    </view>
    <view class="sv-foot"><text>{{siteName}} · 群友整理的软件更新</text></view>
  </block>

  <!-- 同步码弹层（R-SHEET-05） -->
  <sheet show="{{syncOpen}}" title="同步收藏" desc="不用注册，用同步码在另一台设备上恢复收藏。" bindclose="closeSync">
    <view class="sv-seg"><view class="sv-seg__item {{syncMode === 'create' ? 'sv-seg__item--on' : ''}}" bindtap="switchSync" data-mode="create" aria-role="tab" aria-selected="{{syncMode === 'create'}}">生成同步码</view><view class="sv-seg__item {{syncMode === 'restore' ? 'sv-seg__item--on' : ''}}" bindtap="switchSync" data-mode="restore" aria-role="tab" aria-selected="{{syncMode === 'restore'}}">输入同步码</view></view>
    <block wx:if="{{syncMode === 'create'}}">
      <block wx:if="{{created}}">
        <text class="bigcode sv-mono" user-select>{{created.code}}</text>
        <text class="sv-small sv-muted center">包含你的 {{created.count}} 个收藏 · {{created.days || 30}} 天内有效 · 不包含任何个人信息</text>
        <view class="sheet-gap"><copy-link primary block value="{{created.raw}}" label="复制同步码" toast="同步码已复制，在新设备上输入即可"/></view>
      </block>
      <block wx:else>
        <text class="sv-small sv-muted block-text">会把你现在的 {{favorites.length}} 个收藏打包成一个 10 位同步码，30 天内有效。</text>
        <button class="sv-btn sv-btn--primary sv-btn--block sheet-gap" disabled="{{syncBusy}}" bindtap="createCode" hover-class="sv-pressed">{{syncBusy ? '生成中…' : '生成同步码'}}</button>
      </block>
    </block>
    <block wx:else>
      <view class="sv-field"><text class="sv-label">在另一台设备上生成的同步码</text><input class="code-input sv-mono" value="{{codeInput}}" maxlength="13" placeholder="XB7K2-M9Q4T" bindinput="onCodeInput" bindconfirm="restoreCode" aria-label="同步码"/></view>
      <text class="sv-small sv-muted block-text">恢复后会和这台设备上的收藏合并，不会覆盖。</text>
      <button class="sv-btn sv-btn--primary sv-btn--block sheet-gap" disabled="{{syncBusy}}" bindtap="restoreCode" hover-class="sv-pressed">{{syncBusy ? '恢复中…' : '恢复收藏'}}</button>
    </block>
    <text wx:if="{{syncError}}" class="sync-error">{{syncError}}</text>
    <button class="sv-btn sv-btn--ghost sv-btn--block sheet-gap2" bindtap="closeSync" hover-class="sv-pressed">关闭</button>
  </sheet>

  <!-- 关于 / 隐私 / 免责（R-GLOBAL-09，内容来自站点设置） -->
  <sheet show="{{textOpen}}" title="{{textTitle}}" bindclose="closeText"><text wx:for="{{textBody}}" wx:key="*this" class="text-p" user-select>{{item}}</text><button class="sv-btn sv-btn--ghost sv-btn--block sheet-gap" bindtap="closeText" hover-class="sv-pressed">关闭</button></sheet>
  <wish-sheet show="{{wishOpen}}" bindclose="closeWish"/>
</view>
