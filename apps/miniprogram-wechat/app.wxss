/* 版本喵 v4 · 小程序全局样式。Token 取自 docs/v4/02-UI设计规范.md §2，换算 1px = 2rpx（§9.3）。
   小红书构建会把 --sv-* 变量引用替换为常量（scripts/build-miniprograms.cjs），两端渲染一致。 */
page{
  --sv-bg:#F4F6FB;--sv-card:#fff;--sv-ink:#141F33;--sv-ink2:#5F6B80;--sv-ink3:#626F84;--sv-line:#E4E9F2;
  --sv-brand:#2457E6;--sv-brand2:#5B8CFF;--sv-brand-soft:#EBF1FF;
  --sv-ok:#147A4A;--sv-ok-soft:#E5F6ED;--sv-warn:#985000;--sv-warn-soft:#FFF1DC;--sv-bad:#B42318;--sv-bad-soft:#FDECEA;
  --sv-gold:#F5B93B;--sv-gray-soft:#EEF1F6;--sv-input-bg:#F1F4F9;--sv-red:#EF4444;
  --sv-sh:0 2rpx 4rpx rgba(20,31,51,.04),0 8rpx 28rpx rgba(20,31,51,.05);
  background:var(--sv-bg);color:var(--sv-ink);font-family:-apple-system,"PingFang SC","Microsoft YaHei",system-ui,sans-serif;font-size:30rpx;line-height:1.6
}
view,text,button,input,textarea,scroll-view{box-sizing:border-box}

/* 按钮重置：覆盖平台默认的 184px 宽度、背景与描边，具体外观由 sv-btn 系列决定。 */
button{margin:0;padding:0;background:transparent;color:inherit;font-size:inherit;line-height:1.4;border-radius:0;text-align:center;min-height:88rpx}
button:not([size=mini]){width:auto;margin-left:0;margin-right:0}
button::after{border:none}
button[disabled]{opacity:1}

/* ---- 工具类 ---- */
.sv-row{display:flex;align-items:center;gap:16rpx}
.sv-grow{flex:1;min-width:0}
.sv-ell{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sv-muted{color:var(--sv-ink2)}
.sv-faint{color:var(--sv-ink3)}
.sv-small{font-size:26rpx}
.sv-xs{font-size:24rpx}
.sv-mono{font-family:ui-monospace,"SF Mono",Consolas,monospace;font-variant-numeric:tabular-nums}
.sv-pressed{opacity:.72}
.sv-hidden{display:none}

/* ---- 布局 ---- */
.sv-page{padding-bottom:48rpx} /* 不设 overflow：会让详情分段栏、搜索栏的 position:sticky 失效 */
.sv-sec{margin:28rpx}
.sv-card{background:var(--sv-card);border:1px solid var(--sv-line);border-radius:32rpx;padding:32rpx;box-shadow:var(--sv-sh)}
.sv-sh{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:20rpx}
.sv-sh__title{font-size:32rpx;font-weight:700;display:flex;align-items:center;gap:10rpx}
.sv-sh__more{font-size:26rpx;color:var(--sv-ink2);padding:22rpx 0 22rpx 24rpx;margin:-22rpx 0;white-space:nowrap}

/* ---- 按钮（UI 规范 §4.1） ---- */
.sv-btn{display:flex;align-items:center;justify-content:center;gap:12rpx;min-height:88rpx;padding:0 32rpx;border-radius:24rpx;font-size:30rpx;font-weight:600;white-space:nowrap}
.sv-btn--primary{background:var(--sv-brand);color:#fff;box-shadow:0 8rpx 24rpx rgba(36,87,230,.25)}
.sv-btn--soft{background:var(--sv-brand-soft);color:var(--sv-brand)}
.sv-btn--ghost{background:#fff;border:1px solid var(--sv-line);color:var(--sv-ink)}
.sv-btn--sm{font-size:26rpx;padding:0 22rpx;border-radius:18rpx}
.sv-btn--lg{min-height:104rpx;font-size:32rpx;border-radius:28rpx}
.sv-btn--block{width:100%!important}
.sv-btn[disabled]{opacity:.45;box-shadow:none}
.sv-btn--off{background:var(--sv-gray-soft);color:var(--sv-ink2);box-shadow:none}

/* ---- 标签（§4.2、§4.3） ---- */
.sv-tag{display:inline-flex;align-items:center;font-size:24rpx;font-weight:600;line-height:42rpx;padding:0 14rpx;border-radius:12rpx;white-space:nowrap;flex-shrink:0}
.sv-tag--ok{background:var(--sv-ok-soft);color:var(--sv-ok)}
.sv-tag--warn{background:var(--sv-warn-soft);color:var(--sv-warn)}
.sv-tag--bad{background:var(--sv-bad-soft);color:var(--sv-bad)}
.sv-tag--opt,.sv-tag--gray{background:var(--sv-gray-soft);color:var(--sv-ink2)}
.sv-tag--brand{background:var(--sv-brand-soft);color:var(--sv-brand)}
.sv-tag--gold{background:#FFF4D6;color:#8A5A00}
.sv-mini{display:inline-block;font-size:22rpx;line-height:36rpx;padding:0 10rpx;border:1px solid var(--sv-line);border-radius:10rpx;background:#fff;color:var(--sv-ink2);white-space:nowrap}
.sv-dot{display:inline-block;width:16rpx;height:16rpx;border-radius:50%;background:var(--sv-red);flex-shrink:0}
.sv-badge{display:inline-flex;align-items:center;justify-content:center;min-width:36rpx;height:36rpx;padding:0 10rpx;border-radius:18rpx;background:var(--sv-red);color:#fff;font-size:22rpx;font-weight:700;line-height:1}
.sv-mark{background:#FFF0B3;color:inherit;border-radius:4rpx}

/* ---- Chips（§4.6）：外层透明内边距把点击区扩到 88rpx ---- */
.sv-chips{white-space:nowrap;width:100%}
.sv-chips__row{display:inline-flex;gap:12rpx;padding:0 28rpx}
.sv-chips--wrap{display:flex;flex-wrap:wrap;gap:0 12rpx}
.sv-chip{display:inline-flex;padding:10rpx 0;flex-shrink:0}
.sv-chip__in{display:flex;align-items:center;min-height:68rpx;padding:0 26rpx;border-radius:999rpx;background:#fff;border:1px solid var(--sv-line);font-size:26rpx;color:var(--sv-ink);white-space:nowrap}
.sv-chip--on .sv-chip__in{background:var(--sv-ink);border-color:var(--sv-ink);color:#fff}

/* ---- 横向滚动容器（§3.3）：滚动限制在容器内，不撑宽页面 ---- */
.sv-hs{white-space:nowrap;width:100%}
.sv-hs__row{display:inline-flex;gap:20rpx;padding:4rpx 28rpx 8rpx;vertical-align:top}

/* ---- 伪搜索框（§4.8） ---- */
.sv-search{display:flex;align-items:center;gap:16rpx;min-height:88rpx;padding:0 28rpx;border-radius:24rpx;background:#fff;color:var(--sv-ink3);font-size:28rpx}

/* ---- 更新卡（§4.4 .rc） ---- */
.sv-rc{display:block;background:#fff;border:1px solid var(--sv-line);border-radius:32rpx;padding:28rpx;margin-bottom:20rpx;box-shadow:var(--sv-sh)}
.sv-rc--fav{border-color:#AFC4F6;background:linear-gradient(180deg,#F6F9FF,#fff)}
.sv-rc__top{display:flex;align-items:center;gap:20rpx}
.sv-rc__name{font-size:31rpx;font-weight:700;display:flex;align-items:center;gap:8rpx;min-width:0}
.sv-rc__ver{font-size:26rpx;color:var(--sv-ink2);margin-top:4rpx}
.sv-rc__ver .old{color:var(--sv-ink3)}
.sv-rc__ver .new{color:var(--sv-ink);font-weight:700}
.sv-rc__sum{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:28rpx;color:var(--sv-ink2);margin:16rpx 0}
.sv-rc__ft{display:flex;align-items:center;gap:8rpx;flex-wrap:wrap;font-size:24rpx;color:var(--sv-ink2)}
.sv-day{display:flex;align-items:center;gap:16rpx;font-size:24rpx;font-weight:700;color:var(--sv-ink2);margin:32rpx 0 16rpx}
.sv-day::after{content:"";flex:1;height:1px;background:var(--sv-line)}
.sv-day--fav{color:var(--sv-brand)}

/* ---- 列表行（§4.5） ---- */
.sv-rank{display:flex;align-items:center;gap:20rpx;padding:18rpx 0;border-top:1px solid var(--sv-line)}
.sv-rank--first{border-top:0}
.sv-rank__no{width:40rpx;text-align:center;font-weight:800;color:var(--sv-ink3);font-style:normal}
.sv-rank__no--1{color:#E5484D}.sv-rank__no--2{color:#F97316}.sv-rank__no--3{color:#F5B93B}
.sv-lr{display:flex;align-items:center;gap:20rpx;padding:20rpx 0;border-top:1px solid var(--sv-line)}
.sv-lr--first{border-top:0}
.sv-lr__name{font-size:28rpx;font-weight:700;display:flex;align-items:center;gap:8rpx}
.sv-lr__meta{font-size:24rpx;color:var(--sv-ink2);margin-top:2rpx}
.sv-setrow{display:flex;justify-content:space-between;align-items:center;gap:20rpx;padding:24rpx 0;min-height:88rpx;border-top:1px solid var(--sv-line);font-size:29rpx}
.sv-setrow--first{border-top:0}
.sv-setrow__sub{display:block;font-size:24rpx;color:var(--sv-ink2);margin-top:4rpx}
.sv-arr{color:var(--sv-ink3)}

/* ---- 公告卡（§4.4 .ac） ---- */
.sv-ac{position:relative;overflow:hidden;display:block;background:#fff;border:1px solid var(--sv-line);border-radius:32rpx;padding:28rpx 28rpx 28rpx 36rpx;margin-bottom:20rpx;box-shadow:var(--sv-sh)}
.sv-ac__bar{position:absolute;left:0;top:0;bottom:0;width:8rpx;background:var(--sv-brand)}
.sv-ac--imp .sv-ac__bar{background:#E5484D}
.sv-ac--tip .sv-ac__bar{background:var(--sv-gold)}
.sv-ac--ended{opacity:.65}
.sv-ac--ended .sv-ac__bar{background:var(--sv-ink3)}
.sv-ac__tags{display:flex;align-items:center;gap:10rpx;flex-wrap:wrap;font-size:24rpx;color:var(--sv-ink2)}
.sv-ac__date{margin-left:auto}
.sv-ac__title{display:block;font-size:31rpx;font-weight:700;line-height:1.45;margin:10rpx 0 6rpx}
.sv-ac__sum{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:27rpx;color:var(--sv-ink2)}
.sv-ac__ft{display:flex;align-items:center;gap:8rpx;flex-wrap:wrap;margin-top:14rpx}

/* ---- 提示框（§4.13） ---- */
.sv-tip{background:#FFF8E8;border:1px solid #F2DDAE;border-radius:24rpx;padding:20rpx 24rpx;font-size:26rpx;color:#6E4A00;margin-top:20rpx;line-height:1.6}
.sv-alert{background:var(--sv-bad-soft);color:#7A1810;border-radius:20rpx;padding:18rpx 24rpx;font-size:26rpx;margin-bottom:20rpx;line-height:1.6}
.sv-alert--warn{background:var(--sv-warn-soft);color:#5E3200}
.sv-alert--info{background:var(--sv-brand-soft);color:#1B3E9E}
.sv-oldnote{background:var(--sv-input-bg);border-radius:20rpx;padding:16rpx 24rpx;font-size:26rpx;color:var(--sv-ink2);margin-bottom:20rpx;line-height:1.6}

/* ---- 表单与分段（§4.6、§4.9） ---- */
.sv-field{margin-top:24rpx}
.sv-label{display:block;font-size:26rpx;font-weight:600;margin-bottom:10rpx}
.sv-input{width:100%;min-height:88rpx;border:1px solid var(--sv-line);border-radius:20rpx;padding:0 24rpx;font-size:28rpx;background:#fff;color:var(--sv-ink)}
.sv-textarea{width:100%;height:200rpx;border:1px solid var(--sv-line);border-radius:20rpx;padding:18rpx 24rpx;font-size:28rpx;background:#fff;color:var(--sv-ink)}
.sv-count{display:block;text-align:right;font-size:24rpx;color:var(--sv-ink2);margin-top:6rpx}
.sv-seg{display:flex;background:var(--sv-gray-soft);border-radius:24rpx;padding:8rpx;gap:8rpx;margin-top:20rpx}
.sv-seg__item{flex:1;display:flex;align-items:center;justify-content:center;min-height:76rpx;border-radius:18rpx;font-size:28rpx;color:var(--sv-ink2)}
.sv-seg__item--on{background:#fff;color:var(--sv-ink);font-weight:700;box-shadow:var(--sv-sh)}
.sv-actions{display:flex;gap:16rpx;margin-top:28rpx}
.sv-actions>button,.sv-actions>view{flex:1;min-width:0}

/* ---- 空状态与页脚 ---- */
.sv-empty{text-align:center;color:var(--sv-ink2);font-size:28rpx;padding:52rpx 20rpx}
.sv-empty__e{display:block;font-size:68rpx;margin-bottom:8rpx}
.sv-empty__sub{display:block;font-size:25rpx;margin-top:6rpx}
.sv-foot{text-align:center;font-size:24rpx;color:var(--sv-ink2);padding:40rpx 32rpx 48rpx;line-height:1.7}
.sv-foot text{display:block}
