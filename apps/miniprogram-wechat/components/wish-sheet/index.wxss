.field{margin-top:24rpx}
.label{display:block;font-size:26rpx;font-weight:600;color:#141F33;margin-bottom:10rpx}
.input{width:100%;box-sizing:border-box;min-height:88rpx;border:1px solid #E4E9F2;border-radius:20rpx;padding:0 24rpx;font-size:28rpx;color:#141F33;background:#fff}
.chips{display:flex;flex-wrap:wrap;gap:0 12rpx}
.chip{padding:10rpx 0}
.chip__in{display:flex;align-items:center;min-height:68rpx;padding:0 26rpx;border-radius:999rpx;border:1px solid #E4E9F2;background:#fff;font-size:26rpx;color:#141F33}
.chip__in--on{background:#141F33;border-color:#141F33;color:#fff}
.error{display:block;font-size:24rpx;color:#B42318;margin-top:16rpx}
.submit,.cancel{display:flex;align-items:center;justify-content:center;width:100%!important;min-height:88rpx;margin:28rpx 0 0;border-radius:24rpx;font-size:30rpx;font-weight:600;line-height:1.4}
.submit{background:#2457E6;color:#fff;box-shadow:0 8rpx 24rpx rgba(36,87,230,.25)}
.submit[disabled]{background:#2457E6!important;color:#fff!important;opacity:.45;box-shadow:none}
.cancel{background:#fff;color:#141F33;border:1px solid #E4E9F2;margin-top:20rpx}
.submit::after,.cancel::after{border:none}
.pressed{opacity:.8}
