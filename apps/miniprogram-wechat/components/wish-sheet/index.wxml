<sheet show="{{show}}" title="想要什么软件？" desc="告诉群主，收录后会在“我的 → 想要的软件”里显示。" bindclose="close"><view class="field"><text class="label">软件名称</text><input class="input" value="{{value}}" maxlength="30" placeholder="例如：某某输入法" bindinput="onName" aria-label="软件名称"/></view><view class="field"><text class="label">用在什么设备（可多选）</text><view class="chips"><view wx:for="{{devices}}" wx:key="id" class="chip" data-id="{{item.id}}" bindtap="toggleDevice" aria-role="checkbox" aria-checked="{{item.on}}"><text class="chip__in {{item.on ? 'chip__in--on' : ''}}">{{item.text}}</text></view></view></view><view class="field"><text class="label">用途（选填）</text><input class="input" value="{{note}}" maxlength="50" placeholder="比如：电视上看直播" bindinput="onNote" aria-label="用途"/></view><text wx:if="{{error}}" class="error">{{error}}</text><button class="submit" disabled="{{!canSubmit || submitting}}" bindtap="submit" hover-class="pressed">{{submitting ? '提交中…' : '提交'}}</button><button class="cancel" bindtap="close" hover-class="pressed">关闭</button></sheet>
