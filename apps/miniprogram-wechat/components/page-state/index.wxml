<view wx:if="{{loading}}" class="state" aria-role="status" aria-label="正在加载"><view class="skeleton short"/><view class="skeleton"/><view class="skeleton"/></view><view wx:elif="{{error}}" class="state" aria-role="alert"><text class="emoji">😵</text><text class="title">加载失败了</text><text class="description">{{error}}</text><button class="action" bindtap="retry" hover-class="pressed">重试</button></view><view wx:elif="{{empty}}" class="state"><text class="emoji">{{emptyIcon}}</text><text class="title">{{emptyTitle}}</text><text wx:if="{{emptyText}}" class="description">{{emptyText}}</text><button wx:if="{{actionText}}" class="action" bindtap="action" hover-class="pressed">{{actionText}}</button></view>
