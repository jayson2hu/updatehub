.state{padding:70rpx 20rpx;text-align:center;color:#687c6e;font-size:28rpx}.title{display:block;font-size:36rpx;font-weight:600;color:#253d30;margin-bottom:18rpx}.description{display:block;line-height:1.9;margin-bottom:30rpx}.state button{min-height:88rpx;display:flex;align-items:center;justify-content:center;padding:16rpx 30rpx;font-size:28rpx;border:1rpx solid #d6e3d7;border-radius:12rpx;background:#fff;color:#35664a}.state button:after{border:0}.skeleton{height:140rpx;background:#e6eee4;border-radius:16rpx;margin-bottom:28rpx}.skeleton.short{height:40rpx;width:50%;margin-bottom:35rpx}
