.ico{flex-shrink:0;display:flex;align-items:center;justify-content:center;overflow:hidden;color:#fff;font-weight:800;background-image:linear-gradient(135deg,rgba(255,255,255,.16),rgba(0,0,0,.1));box-shadow:inset 0 -4rpx 0 rgba(0,0,0,.08)}
.ico image{width:100%;height:100%}
.ico--sm{width:72rpx;height:72rpx;border-radius:20rpx;font-size:30rpx}
.ico--md{width:92rpx;height:92rpx;border-radius:26rpx;font-size:38rpx}
.ico--lg{width:128rpx;height:128rpx;border-radius:34rpx;font-size:54rpx}
