<button class="copy {{primary ? 'copy--primary' : soft ? 'copy--soft' : 'copy--ghost'}} {{block ? 'copy--block' : ''}} {{large ? 'copy--lg' : ''}} {{small ? 'copy--sm' : ''}}" bindtap="copy" disabled="{{!value}}" hover-class="pressed" aria-label="{{value ? label : disabledText || label}}">{{value ? (copied ? '已复制 ✓' : label) : (disabledText || label)}}</button><view wx:if="{{manual}}" class="copy-mask" bindtap="close" catchtouchmove="stop"><view class="copy-sheet" catchtap="stop" aria-role="dialog" aria-label="请手动复制"><text class="copy-title">请手动复制</text><text class="copy-help">当前环境不允许自动复制。长按下面的文字，选择「复制」，再到浏览器粘贴打开。</text><text class="copy-value" user-select selectable>{{value}}</text><button bindtap="close" class="copy copy--primary copy--block">我知道了</button></view></view>
