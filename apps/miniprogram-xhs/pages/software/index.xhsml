<view class="page"><view class="hero"><text class="site-title">找到常用的软件</text><text class="description">先选设备，再查看版本和安装方法。</text></view><page-state loading="{{loading}}" error="{{error}}" bindretry="retry"/><block xhs:if="{{!loading && !error}}"><view class="search"><text class="search-symbol">⌕</text><input value="{{query}}" placeholder="软件名称或常用别名" bindinput="onSearch" confirm-type="search" aria-label="搜索软件"/><button xhs:if="{{query}}" bindtap="clear">清除</button></view><view class="filters"><button xhs:for="{{platforms}}" xhs:key="id" class="filter {{selectedPlatform === item.id ? 'active' : ''}}" bindtap="onPlatform" data-id="{{item.id}}" hover-class="pressed">{{item.label}}</button></view><view class="section-heading"><text class="title">软件目录</text><text class="meta">{{software.length}} 款软件</text></view><page-state empty="{{!software.length}}" empty-title="没有找到对应软件" empty-text="换个关键词，或清除设备筛选。" bindretry="clear"/><view xhs:for="{{software}}" xhs:key="id" class="directory-card" bindtap="openSoftware" data-slug="{{item.slug}}" data-platform="{{selectedPlatform === 'all' ? '' : selectedPlatform}}" aria-role="link" hover-class="pressed"><app-icon name="{{item.name}}" color="{{item.color}}" src="{{item.icon}}"/><view class="directory-content"><text class="software-name">{{item.name}} ›</text><text class="directory-summary">{{item.summary}}</text><view class="directory-bottom"><text class="directory-devices">{{item.devices}}</text><text class="status {{item.status}}"><text class="status-dot"/>{{item.statusText}}</text></view></view></view><text class="footnote">{{hasDemo ? '示例软件 · ' : ''}}获取入口由管理员维护，同一软件的新旧版本保留在详情页。</text></block></view>
