<view class="page detail-page"><page-state loading="{{loading}}" error="{{error}}" bindretry="retry"/><block xhs:if="{{software && !loading && !error}}">
  <view class="detail-hero"><app-icon large name="{{software.name}}" color="{{software.color}}" src="{{software.icon}}"/><view><text class="site-title">{{software.name}}</text><text class="description">{{software.summary}}</text><text xhs:if="{{software.is_demo}}" class="demo">示例软件</text></view></view>
  <copy-link value="{{websiteLink}}" label="复制网站详情链接"/>
  <view xhs:for="{{notices}}" xhs:key="id" class="related-notice" data-slug="{{item.slug}}" bindtap="openNotice" hover-class="pressed"><text>重要提醒</text><text>{{item.title}} ›</text></view>
  <view class="panel version-panel" id="version"><text class="panel-title">选择你的设备</text><view class="devices"><button xhs:for="{{platforms}}" xhs:key="id" class="device-button {{platform === item.id ? 'active' : ''}}" bindtap="onPlatform" data-id="{{item.id}}" hover-class="pressed">{{item.name}}</button></view><text class="small muted">选择版本</text><picker xhs:if="{{releases.length}}" mode="selector" range="{{releases}}" range-key="label" value="{{selectedIndex}}" bindchange="onVersion"><view class="version-picker" aria-role="button" aria-label="选择版本">{{release.label}} <text>⌄</text></view></picker><view xhs:else class="no-version">这个设备暂未发布版本，可以查看其他设备。</view><block xhs:if="{{release}}"><view class="version-header"><view><text class="device">{{platformName}}</text><view class="version-number">v{{release.version}}<text>{{release.latest ? '最新版本' : '历史版本'}}</text></view></view><text class="status {{release.status}}"><text class="status-dot"/>{{release.statusText}}</text></view><text class="release-date">更新日期 {{release.date}}</text><text class="panel-title">本次更新</text><text class="summary-lead">{{release.summary}}</text><view class="body"><text xhs:for="{{release.paragraphs}}" xhs:key="*this" class="paragraph">{{item}}</text></view></block></view>
  <view class="panel"><text class="panel-title">获取{{platformName}}版本</text><view xhs:if="{{release.install_notice}}" class="install-notice">{{release.install_notice}}</view><block xhs:if="{{primary}}"><text class="source">来源：{{primary.source}}</text><copy-link primary value="{{primary.url}}" label="{{copyLabel}}"/><view xhs:if="{{primary.code}}" class="code-row"><text>提取码 <text class="code">{{primary.code}}</text></text><copy-link value="{{primary.code}}" label="复制提取码"/></view><view xhs:for="{{backups}}" xhs:key="url" class="backup"><text class="source">备用入口：{{item.source}}</text><copy-link value="{{item.url}}" label="复制备用获取链接"/><view xhs:if="{{item.code}}" class="code-row"><text>提取码 {{item.code}}</text><copy-link value="{{item.code}}" label="复制提取码"/></view></view></block><view xhs:else class="unavailable"><text class="unavailable-title">{{release.status === 'unavailable' ? '暂时无法使用' : '暂不可获取'}}</text><text>{{noLink}}</text><button disabled>暂未配置获取链接</button></view><view class="get-help"><text>小程序不能直接打开任意外部下载页面。</text><text>复制获取链接后，在常用浏览器中粘贴打开，再按来源网站的提示操作。</text></view></view>
  <ad-slot enabled="{{adsEnabled}}" promotions="{{promotions}}" placement="detail_body"/>
  <view class="panel"><text class="panel-title">安装方法</text><view xhs:if="{{!software.installation.length}}" class="body">管理员尚未补充安装方法，请先阅读版本提醒。</view><view xhs:for="{{software.installation}}" xhs:key="*this" class="step"><text class="step-number">{{index + 1}}</text><text class="step-content">{{item}}</text></view><image xhs:for="{{screenshots}}" xhs:key="*this" class="content-image" src="{{item}}" mode="widthFix" lazy-load bindtap="preview" data-src="{{item}}"/></view>
  <view class="panel"><text class="panel-title">常见问题</text><view xhs:if="{{!faqs.length}}" class="body">暂无常见问题，安装前请留意重要公告。</view><view xhs:for="{{faqs}}" xhs:key="question" class="faq"><button class="faq-title" data-index="{{index}}" bindtap="toggleFaq">{{item.question}}<text>{{item.open ? '−' : '+'}}</text></button><text xhs:if="{{item.open}}" class="faq-answer">{{item.answer}}</text></view></view>
  <view class="panel history-panel"><button bindtap="toggleHistory" class="history-title">历史版本记录 <text>{{history.length}} 个版本 {{historyOpen ? '⌃' : '⌄'}}</text></button><view xhs:if="{{historyOpen}}"><view xhs:if="{{!history.length}}" class="small muted">暂无历史版本。后续更新会保留在这里。</view><view xhs:for="{{history}}" xhs:key="id" class="history-row" bindtap="selectHistory" data-id="{{item.id}}" hover-class="pressed"><text>v{{item.version}}</text><text>{{item.label}}</text><text>查看 ›</text></view></view></view>
  <text class="footnote">获取入口由管理员维护。请确认设备与版本，本站不托管安装包。</text>
</block></view><view xhs:if="{{software && !error && !loading}}" class="fixed-get"><view class="fixed-meta"><text>{{platformName}} {{release ? 'v' + release.version : ''}}</text><text>{{primary ? primary.source : '暂未配置获取链接'}}</text></view><copy-link xhs:if="{{primary}}" primary value="{{primary.url}}" label="复制获取链接"/><button xhs:else disabled>暂不可获取</button></view>
