<view class="sv-page">
  <page-state loading="{{loading}}" error="{{error}}" bindretry="retry"/>
  <block xhs:if="{{!loading && !error}}">
    <scroll-view scroll-x class="sv-chips types" enhanced show-scrollbar="{{false}}"><view class="sv-chips__row">
      <view xhs:for="{{types}}" xhs:key="id" class="sv-chip {{category === item.id ? 'sv-chip--on' : ''}}" bindtap="onCategory" data-id="{{item.id}}" aria-role="button" aria-selected="{{category === item.id}}"><text class="sv-chip__in">{{item.label}}</text></view>
    </view></scroll-view>
    <view class="sv-sec list">
      <page-state empty="{{!notices.length}}" empty-title="暂时没有这类公告" action-text="{{category === 'all' ? '' : '看全部公告'}}" bindaction="clear"/>
      <view xhs:for="{{notices}}" xhs:key="id" class="sv-ac sv-ac--{{item.tone}}" bindtap="openNotice" data-slug="{{item.slug}}" hover-class="sv-pressed" aria-role="link" aria-label="{{item.title}}">
        <view class="sv-ac__bar"/>
        <view class="sv-ac__tags"><text xhs:if="{{item.activePinned}}" class="sv-tag sv-tag--gold">📌 置顶</text><text class="sv-tag sv-tag--{{item.typeTone}}">{{item.important ? '重要 · ' + item.categoryText : item.categoryText}}</text><text xhs:if="{{item.ended}}" class="sv-tag sv-tag--gray">已结束</text><text class="sv-ac__date">{{item.shortDate}}</text></view>
        <text class="sv-ac__title">{{item.title}}</text>
        <text class="sv-ac__sum">{{item.summary}}</text>
        <view xhs:if="{{item.related.length}}" class="sv-ac__ft"><text xhs:for="{{item.related}}" xhs:for-item="s" xhs:key="id" class="sv-mini">{{s.text}}</text></view>
      </view>
      <button xhs:if="{{hasMore}}" class="sv-btn sv-btn--ghost sv-btn--block" bindtap="loadMore" hover-class="sv-pressed">加载更多</button>
    </view>
    <view class="sv-foot"><text>到期公告自动退出置顶，历史详情仍可打开。</text></view>
  </block>
</view>
