<view class="sv-page">
  <page-state loading="{{loading}}" error="{{error}}" bindretry="retry"/>
  <block xhs:if="{{notice && !error && !loading}}">
    <view class="sv-sec article">
      <view xhs:if="{{notice.ended}}" class="sv-oldnote">这条公告已结束，内容仅供参考。</view>
      <view class="sv-ac__tags"><text xhs:if="{{notice.activePinned}}" class="sv-tag sv-tag--gold">📌 置顶</text><text class="sv-tag sv-tag--{{notice.typeTone}}">{{notice.important ? '重要 · ' + notice.categoryText : notice.categoryText}}</text><text xhs:if="{{notice.ended}}" class="sv-tag sv-tag--gray">已结束</text><text xhs:if="{{notice.is_demo}}" class="sv-tag sv-tag--gray">示例</text></view>
      <text class="meta">{{notice.metaText}}</text>
      <text class="title" user-select>{{notice.title}}</text>
      <text xhs:if="{{notice.summary}}" class="lead" user-select>{{notice.summary}}</text>
      <view class="body"><text xhs:for="{{notice.paragraphs}}" xhs:key="*this" class="paragraph" user-select>{{item}}</text></view>
      <image xhs:for="{{notice.images}}" xhs:key="*this" src="{{item}}" class="content-image" mode="widthFix" lazy-load bindtap="preview" data-src="{{item}}"/>
      <!-- 外链：小程序不能跳转，显示为可长按选择的文本 + 复制按钮 -->
      <view xhs:for="{{notice.links}}" xhs:key="url" class="link-box"><text class="link-label">{{item.label || '相关链接'}}</text><text class="link-url" user-select>{{item.url}}</text><copy-link small value="{{item.url}}" label="复制链接" toast="链接已复制，去浏览器粘贴打开"/></view>
    </view>
    <view xhs:if="{{software.length}}" class="sv-sec sv-card">
      <view class="sv-sh"><text class="sv-sh__title">相关软件</text></view>
      <view xhs:for="{{software}}" xhs:key="id" class="sv-lr {{index === 0 ? 'sv-lr--first' : ''}}" data-slug="{{item.slug}}" bindtap="openSoftware" hover-class="sv-pressed" aria-role="link" aria-label="查看{{item.name}}">
        <app-icon size="sm" name="{{item.name}}" color="{{item.color}}" src="{{item.icon}}"/>
        <view class="sv-grow"><text class="sv-lr__name">{{item.name}}</text><text class="sv-lr__meta sv-mono">{{item.meta}}</text></view>
        <text xhs:if="{{item.tag}}" class="sv-tag sv-tag--{{item.tag.tone}}">{{item.tag.text}}</text>
      </view>
    </view>
    <view class="sv-sec"><copy-link block value="{{websiteLink}}" label="🔗 复制公告链接" toast="公告链接已复制"/></view>
    <view class="sv-foot"><text>点右上角「···」可以分享给群友；复制的链接可以在浏览器打开。</text></view>
  </block>
</view>
