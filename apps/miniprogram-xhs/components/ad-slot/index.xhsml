<view xhs:if="{{promotion && !failed && !closed}}" class="ad ad--{{variant}}"><view class="ad__main" bindtap="click" hover-class="ad__pressed" aria-role="button" aria-label="广告：{{promotion.title}}，点击复制链接"><image xhs:if="{{promotion.cover}}" class="ad__img" src="{{promotion.cover}}" mode="aspectFill" lazy-load binderror="onError"/><view class="ad__text"><text class="ad__title">{{promotion.title}}</text><text class="ad__desc">{{variant === 'wide' ? '复制链接 ›' : (promotion.summary ? promotion.summary + ' · ' : '') + '复制链接 ›'}}</text></view></view><text class="ad__label">广告</text><view class="ad__close" catchtap="close" aria-role="button" aria-label="关闭广告"><text>✕</text></view></view>
