<view xhs:if="{{show}}" class="sheet-root"><view class="sheet-mask" bindtap="close" catchtouchmove="noop"/><view class="sheet" aria-role="dialog" aria-modal="true" aria-label="{{title}}"><view class="sheet__grip" catchtouchmove="noop"/><view class="sheet__head" catchtouchmove="noop"><text class="sheet__title">{{title}}</text><button class="sheet__close" bindtap="close" aria-label="关闭" hover-class="sheet__pressed">✕</button></view><text xhs:if="{{desc}}" class="sheet__desc">{{desc}}</text><scroll-view scroll-y class="sheet__body"><slot/></scroll-view></view></view>
