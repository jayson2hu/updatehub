<view wx:if="{{loading}}" class="state" aria-role="status"><view class="skeleton short"/><view class="skeleton"/><view class="skeleton"/><text>正在加载小站内容…</text></view><view wx:elif="{{error}}" class="state"><text class="title">内容暂时没有加载成功</text><text class="description">{{error}}</text><button bindtap="retry">重新加载</button></view><view wx:elif="{{empty}}" class="state"><text class="title">{{emptyTitle}}</text><text class="description">{{emptyText}}</text><button bindtap="retry">清除筛选</button></view>
