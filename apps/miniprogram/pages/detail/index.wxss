/* 软件详情（UI 规范 §5.4 手机） */
.detail{padding-bottom:calc(200rpx + env(safe-area-inset-bottom))}
.head{display:flex;gap:24rpx;align-items:flex-start;margin-top:32rpx}
.head__name{display:block;font-size:42rpx;font-weight:700;line-height:1.25;margin:4rpx 0 8rpx}
.head__sum{display:block;font-size:26rpx;color:#5F6B80;line-height:1.6;margin-bottom:8rpx}
.head__ops{display:flex;flex-direction:column;gap:8rpx;flex-shrink:0;margin-right:-12rpx}
.op{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:88rpx;min-height:88rpx;font-size:34rpx;color:#5F6B80;line-height:1.1}
.op--on{color:#F5A623}
.op__t{font-size:20rpx;color:#5F6B80;margin-top:4rpx}
.kpis{display:grid;grid-template-columns:repeat(3,1fr);background:#fff;border:1px solid #E4E9F2;border-radius:28rpx;margin-top:8rpx}
.kpi{text-align:center;padding:20rpx 8rpx;border-left:1px solid #E4E9F2;display:flex;flex-direction:column}
.kpi:first-child{border-left:0}
.kpi__v{font-size:32rpx;font-weight:700}
.kpi__v--ok{color:#147A4A}
.kpi__l{font-size:23rpx;color:#5F6B80}
.verdict{display:flex;gap:24rpx;align-items:flex-start;border-radius:28rpx;padding:26rpx 28rpx}
.verdict--ok{background:#E5F6ED;color:#0D5233}
.verdict--warn{background:#FFF1DC;color:#5E3200}
.verdict--bad{background:#FDECEA;color:#7A1810}
.verdict--opt{background:#EEF1F6;color:#141F33}
.verdict__i{flex-shrink:0;width:68rpx;height:68rpx;border-radius:50%;background:rgba(255,255,255,.7);display:flex;align-items:center;justify-content:center;font-size:34rpx;font-weight:800}
.verdict__t{display:block;font-size:32rpx;font-weight:700}
.verdict__n{display:block;font-size:26rpx;line-height:1.6;margin-top:4rpx}
.devpick{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin-top:12rpx}
.dev{position:relative;min-height:116rpx;border:3rpx solid #E4E9F2;border-radius:24rpx;background:#fff;font-size:25rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1.25}
.dev__e{font-size:38rpx}
.dev--on{border-color:#2457E6;background:#EBF1FF;color:#2457E6;font-weight:700}
.dev--off{opacity:.35}
.dev__local{position:absolute;top:-16rpx;right:-8rpx;font-size:20rpx;line-height:32rpx;padding:0 10rpx;border-radius:12rpx;background:#2457E6;color:#fff;font-weight:400}
.vsel{white-space:nowrap;width:auto;margin:24rpx -32rpx}
.vsel__row{display:inline-flex;gap:12rpx;padding:0 32rpx}
.vsel__item{display:inline-flex;flex-direction:column;justify-content:center;min-height:88rpx;border:1px solid #E4E9F2;border-radius:20rpx;padding:8rpx 20rpx;font-size:24rpx;background:#fff;line-height:1.35}
.vsel__item--on{border-color:#2457E6;background:#EBF1FF;color:#2457E6}
.vsel__v{font-size:28rpx;font-weight:700}
.vsel__m{color:inherit}
.vsel-gap{height:24rpx}
.secondary{margin-top:16rpx}
.meta2{display:flex;gap:20rpx;flex-wrap:wrap;font-size:24rpx;color:#5F6B80;margin-top:18rpx}
.hint{display:block;font-size:24rpx;color:#5F6B80;line-height:1.6;margin-top:16rpx}
.backup{display:flex;flex-direction:column;gap:4rpx;border:3rpx dashed #C9D3E4;border-radius:24rpx;padding:20rpx 24rpx;margin-top:20rpx;background:#FAFBFD}
.backup__ops{display:flex;gap:16rpx;margin-top:12rpx}
.code-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:16rpx}
.backup__t{display:block;font-size:26rpx;font-weight:700}
.backup__s{display:block;font-size:24rpx;color:#5F6B80;margin-top:2rpx}
.code{font-weight:800;color:#141F33;letter-spacing:2rpx;background:#fff;border:1px solid #E4E9F2;border-radius:10rpx;padding:0 10rpx}
.pc-tip{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.ad-wrap{margin-top:0;margin-bottom:0}
.dtabs-wrap{position:sticky;top:0;z-index:5;background:#F4F6FB;border-bottom:1px solid #E4E9F2}
.dtabs{white-space:nowrap;width:100%}
.dtabs__row{display:inline-flex;gap:4rpx;padding:16rpx 28rpx}
.dtab{display:inline-flex;align-items:center;min-height:76rpx;padding:0 24rpx;border-radius:20rpx;font-size:28rpx;color:#5F6B80}
.dtab--on{background:#fff;color:#141F33;font-weight:700;box-shadow:var(--sv-sh)}
.tab-body{margin-top:20rpx}
.diff{display:flex;align-items:center;flex-wrap:wrap;gap:16rpx;font-size:28rpx;margin-bottom:20rpx}
.diff__v{background:#F1F4F9;border-radius:12rpx;padding:2rpx 14rpx}
.diff__v--new{background:#EBF1FF;color:#2457E6;font-weight:700}
.nl{display:flex;gap:16rpx;align-items:flex-start;padding:12rpx 0;font-size:29rpx}
.k{flex-shrink:0;font-size:22rpx;font-weight:700;border-radius:10rpx;padding:0 12rpx;line-height:40rpx;margin-top:4rpx}
.k--add{background:#E5F6ED;color:#147A4A}
.k--fix{background:#EBF1FF;color:#2457E6}
.k--opt{background:#F3EEFF;color:#6D28D9}
.k--known{background:#FDECEA;color:#B42318}
.nl__t{flex:1;min-width:0;line-height:1.6}
.note{display:block;font-size:28rpx;color:#5F6B80;line-height:1.7;margin:8rpx 0}
.shots{white-space:nowrap;width:auto;margin:24rpx -32rpx 0}
.shots__row{display:inline-flex;gap:16rpx;padding:0 32rpx}
.shot{width:220rpx;height:392rpx;border-radius:24rpx;background:#EEF1F6;flex-shrink:0}
.step{display:flex;gap:20rpx;padding:20rpx 0;border-top:1px solid #E4E9F2}
.step--first{border-top:0}
.step__n{flex-shrink:0;width:52rpx;height:52rpx;border-radius:50%;background:#2457E6;color:#fff;font-size:26rpx;font-weight:700;display:flex;align-items:center;justify-content:center}
.step__t{flex:1;min-width:0;font-size:28rpx;line-height:1.7}
.faq{border-top:1px solid #E4E9F2}
.faq--first{border-top:0}
.faq__q{display:flex;align-items:center;gap:20rpx;min-height:92rpx;font-size:29rpx;font-weight:600}
.faq__s{font-size:40rpx;color:#8A95A8;font-weight:400}
.faq__a{display:block;font-size:28rpx;color:#5F6B80;line-height:1.7;padding-bottom:24rpx}
.tl{position:relative;padding-left:40rpx}
.tl::before{content:"";position:absolute;left:12rpx;top:16rpx;bottom:16rpx;width:4rpx;background:#E4E9F2}
.tl__n{position:relative;padding:16rpx 0 20rpx}
.tl__n::before{content:"";position:absolute;left:-38rpx;top:30rpx;width:24rpx;height:24rpx;border-radius:50%;background:#fff;border:5rpx solid #8A95A8;box-sizing:border-box}
.tl__n--cur::before{border-color:#2457E6;background:#2457E6}
.tl__n--bad::before{border-color:#B42318}
.tl__v{font-size:30rpx;font-weight:700}
.tl__s{display:block;font-size:26rpx;color:#5F6B80;margin-top:6rpx}
.tl__go{display:flex;align-items:center;min-height:72rpx;font-size:26rpx;color:#2457E6}
.info{display:flex;align-items:center;gap:16rpx;padding:18rpx 0;border-top:1px solid #E4E9F2;font-size:28rpx;min-height:88rpx}
.info--first{border-top:0}
.info__l{width:184rpx;flex-shrink:0;color:#5F6B80}
.info__v{flex:1;min-width:0;word-break:break-all}
.desc{display:block;font-size:27rpx;color:#5F6B80;line-height:1.7;margin-top:20rpx}
.fb{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}
.fb__b{display:flex;align-items:center;justify-content:center;min-height:96rpx;border:3rpx solid #E4E9F2;border-radius:24rpx;background:#fff;font-size:28rpx}
.fb__b--on{border-color:#2457E6;background:#EBF1FF;color:#2457E6;font-weight:700}
.bar{height:16rpx;border-radius:8rpx;background:#F9D6D2;overflow:hidden;margin-top:24rpx}
.bar__i{height:100%;border-radius:8rpx;background:linear-gradient(90deg,#34B37A,#1F9A62)}
.fb__text{display:block;margin-top:12rpx}
.fb__warn{color:#B42318}
.hs-bleed{margin:0 -28rpx;width:auto}
.sim{display:inline-flex;flex-direction:column;gap:8rpx;vertical-align:top;white-space:normal;width:260rpx;background:#fff;border:1px solid #E4E9F2;border-radius:28rpx;padding:24rpx}
.sim__n{font-size:27rpx;font-weight:700;max-width:100%}
.sticky{position:fixed;left:0;right:0;bottom:0;z-index:20;display:flex;align-items:center;gap:16rpx;background:#fff;border-top:1px solid #E4E9F2;padding:20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom))}
.sticky__fb{flex-shrink:0;padding:0 24rpx}
.issue-kinds{margin-top:12rpx}
.sheet-btn{margin-top:28rpx}
.sheet-btn2{margin-top:20rpx}
.share-preview{display:block;white-space:pre-wrap;font-size:26rpx;line-height:1.6;background:#F7F8FA;border:1px solid #E4E9F2;border-radius:20rpx;padding:20rpx 24rpx;margin-top:16rpx;color:#141F33}

.step__image{display:block;width:100%;max-width:480px;margin-top:12px;border-radius:12px}
