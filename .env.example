# Copy to .env. Generate a unique password before starting either Compose configuration.
# Never commit .env. The password intentionally has no default.
POSTGRES_PASSWORD=
STATION_SIGNING_KEY=
# Exact approved native-app HTTPS Referer prefixes, comma separated and ending in /.
MINIAPP_REFERER_PREFIXES=
LEGACY_ENABLED=false

POSTGRES_DB=updatehub
POSTGRES_USER=updatehub
PUBLIC_SITE_URL=http://localhost:3000
SITE_NAME=UpdateHub
SITE_DESCRIPTION=查看软件更新、使用提醒与维护通知，了解影响和下一步行动。

# Used only by the explicit create-admin command; do not keep a password here afterwards.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Production: set a real domain and an HTTPS PUBLIC_SITE_URL.
DOMAIN=
ACME_EMAIL=

# Direct local API development only; Compose sets these inside its containers.
# DATABASE_URL=postgresql+psycopg://updatehub:URL_ENCODED_PASSWORD@localhost:5432/updatehub
# DATABASE_URL=sqlite:///./updatehub.db
# ENVIRONMENT=development
# API_INTERNAL_URL=http://127.0.0.1:8000
# UPLOAD_DIR=./uploads
# SESSION_TTL_HOURS=12
# CORS_ORIGINS=http://localhost:3000
# NEXT_TELEMETRY_DISABLED=1
# Sessions use random opaque tokens with server-side hashes; no SECRET_KEY is needed.
