# Copy to .env on the Linux server only. chmod 600 .env. Never commit real values.
# Generate POSTGRES_PASSWORD and STATION_SIGNING_KEY separately (64 hexadecimal characters each).
POSTGRES_PASSWORD=
STATION_SIGNING_KEY=
POSTGRES_DB=updatehub
POSTGRES_USER=updatehub

# DOMAIN is a hostname without scheme, path or port. Both values must refer to your actual domain.
DOMAIN=
PUBLIC_SITE_URL=
ACME_EMAIL=
SITE_NAME=版本喵
SITE_DESCRIPTION=软件更新、安装说明和群公告，都在这里

# Supply a separate production administrator. Clear the password after create-admin succeeds.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Empty until native apps are ready. Use exact HTTPS app-specific paths ending in /.
MINIAPP_REFERER_PREFIXES=
LEGACY_ENABLED=false
