# 本地开发示例；脚本不会自动加载本文件。
# scripts/station-env.ps1 使用仓库内 runtime/ 的绝对路径作为默认数据位置。
ENVIRONMENT=development
DATABASE_URL=sqlite:///D:/fayun/code/updatehub/runtime/station.db
UPLOAD_DIR=D:/fayun/code/updatehub/runtime/station-uploads
PUBLIC_SITE_URL=http://localhost:3010
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
API_INTERNAL_URL=http://127.0.0.1:8010
SESSION_TTL_HOURS=12

# 仅初始化账号时临时设置；建议运行 station-init.ps1 -CreateAdmin 交互输入。
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# 生产必须配置 PostgreSQL、HTTPS 和持久化上传目录，例如：
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://updatehub:CHANGE_ME@postgres:5432/updatehub
# PUBLIC_SITE_URL=https://updates.example.com
# CORS_ORIGINS=https://updates.example.com
# UPLOAD_DIR=/data/uploads
# API_INTERNAL_URL=http://api:8000
