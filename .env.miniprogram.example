# Public AppIDs only. Never include AppSecret in mini-program source or build output.
MINIAPP_WECHAT_APP_ID=
MINIAPP_XHS_APP_ID=
# Local development defaults already work in the developer tools.
MINIAPP_API_BASE=http://127.0.0.1:8010/api/v1
MINIAPP_WEBSITE_BASE=http://localhost:3010
# For trial/release, replace both addresses with your real HTTPS domains.
# API base ends in /api/v1; website base is the root origin (no page path).
# Do not include credentials, query strings or fragments; trailing / is normalized.
# Check without generating/uploading: node --env-file=.env.miniprogram scripts/build-miniprograms.cjs --env release --check
